#!/usr/bin/env bash
set -euo pipefail

message_file="$1"
first_line="$(head -n 1 "$message_file")"

case "$first_line" in
  "Merge "*|"Revert "*|fixup!*|squash!*)
    exit 0
    ;;
esac

pattern='^(feat|fix|docs|test|refactor|perf|build|ci|chore|revert)(\([a-z0-9-]+\))?: .+$'

if [[ ! "$first_line" =~ $pattern ]]; then
  cat >&2 <<'EOF'
提交信息不符合 SeedField 规范。

格式：<type>(<scope>): <摘要>
类型：feat fix docs test refactor perf build ci chore revert
示例：feat(economy): 部署从区域库存扣除材料

说明见 CONTRIBUTING.md。
EOF
  exit 1
fi
